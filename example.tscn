[sub_resource type="GDScript" id="GDScript_kd6nb"]
script/source = "extends Label



@onready var cognite_node: CogniteNode = $\"../CogniteNode\"


func _process(delta: float) -> void:
	if cognite_node.best_score_decision != -1:
		
		text = cognite_node.cognite_assemble.decisions[cognite_node.best_score_decision].name
"

